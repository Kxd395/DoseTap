# Local Plane origin. The existing ignored `.env` may retain its legacy bare
# project-URL line because the repository helper supports both formats.
PLANE_BASE_URL=http://plane.localhost:3301

# Local Plane API key. Replace the placeholder only in ignored `.env` or export
# the variable in the agent host environment. Never commit the real value.
Plane_DoseTap_API=replace-with-local-plane-api-key
